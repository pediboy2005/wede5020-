// =====================================================
// SWEET CRUMBS BAKERY
// Simple JavaScript for the student website
// =====================================================

document.addEventListener("DOMContentLoaded", function () {

    // Find the enquiry form.
    const enquiryForm = document.getElementById("enquiryForm");
    const formMessage = document.getElementById("formMessage");

    // Show a confirmation when the enquiry form is submitted.
    if (enquiryForm) {
        enquiryForm.addEventListener("submit", function (event) {

            // Stop the page from refreshing.
            event.preventDefault();

            if (formMessage) {
                formMessage.textContent =
                    "Thank you for your enquiry. We will contact you soon.";
            }

            // Clear the form.
            enquiryForm.reset();
        });
    }

    // Find the contact form.
    const contactForm = document.querySelector(".contact-form");

    // Show a confirmation when the contact form is submitted.
    if (contactForm) {
        contactForm.addEventListener("submit", function (event) {

            event.preventDefault();

            alert(
                "Thank you for contacting Sweet Crumbs Bakery. " +
                "We will get back to you soon."
            );

            contactForm.reset();
        });
    }
});